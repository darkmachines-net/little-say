{
  "schemaVersion": 3,
  "repository": "darkmachines-net/little-say",
  "defaultBranch": "master",
  "profiles": {
    "internal": {
      "environment": "preview",
      "channel": "internal",
      "easProfile": "internal",
      "submit": false,
      "approvalEnvironment": "internal",
      "deployEnvironment": "self-hosted-testing",
      "publicEnvironment": {
        "LITTLE_SAY_CHANNEL": "internal"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "easProfile": "production",
      "submit": true,
      "approvalEnvironment": "production",
      "deployEnvironment": "self-hosted-testing",
      "publicEnvironment": {
        "LITTLE_SAY_CHANNEL": "production"
      }
    }
  },
  "install": [
    [
      "npm",
      "ci"
    ]
  ],
  "metadataFiles": [
    "release.json",
    "native-release.json",
    "package.json",
    "package-lock.json",
    "apps/server/package.json",
    "apps/mobile/package.json",
    "apps/mobile/app.json"
  ],
  "hooks": {
    "inspect": [
      "node",
      "scripts/release/hooks.mjs"
    ],
    "prepare": [
      "node",
      "scripts/release/hooks.mjs"
    ],
    "validate": [
      "node",
      "scripts/release/hooks.mjs"
    ],
    "verify": [
      "node",
      "scripts/release/hooks.mjs"
    ]
  },
  "mobile": {
    "directory": "apps/mobile",
    "versionFloor": "0.1.4",
    "inputs": [
      "apps/mobile",
      "packages",
      "native-release.json",
      "package-lock.json"
    ],
    "builder": "eas",
    "projectId": "a0336055-a9d6-46b1-8eb4-120944304685",
    "owner": "matthewchartier",
    "slug": "little-say",
    "publicVariables": [
      "LITTLE_SAY_GOOGLE_IOS_URL_SCHEME"
    ],
    "targets": [
      {
        "id": "android",
        "platform": "android",
        "applicationId": "net.darkmachines.littlesay",
        "buildNumberFloor": 5
      },
      {
        "id": "ios",
        "platform": "ios",
        "applicationId": "net.darkmachines.littlesay",
        "buildNumberFloor": 5
      }
    ]
  },
  "server": {
    "versionFloor": "0.3.3",
    "inputs": [
      "apps/server",
      "apps/mobile",
      "packages",
      "package-lock.json",
      "Dockerfile"
    ],
    "image": "ghcr.io/mchartier/little-say",
    "dockerfile": "Dockerfile",
    "platforms": [
      "linux/amd64"
    ],
    "smoke": {
      "port": 8787,
      "healthPath": "/api/ready"
    },
    "deployment": {
      "service": "little-say",
      "path": "/deploy/little-say"
    }
  }
}
