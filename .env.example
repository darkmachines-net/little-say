# The key stays on your server. Never use an EXPO_PUBLIC variable for a secret.
# AAC_OPENAI_KEY in your environment is preferred. On Windows, npm run dev
# also reads that User variable when the current terminal hasn't inherited it.
# Leave this blank when using AAC_OPENAI_KEY; no key is copied into this file.
OPENAI_API_KEY=
OPENAI_BOARD_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
OPENAI_SPEECH_VOICE=marin
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Board preparation uses these settings automatically when AI is configured.
OPENAI_DRAFT_MODEL=gpt-6-luna
OPENAI_DRAFT_REASONING_EFFORT=none
OPENAI_PICTURE_MATCH_MODEL=gpt-6-luna
# Low quality is an evaluation option; medium remains the default.
OPENAI_IMAGE_QUALITY=medium
# Hosted AI capacity. Give the API and every worker the same settings.
AAC_AI_ACCOUNT_BOARD_STARTS_PER_MINUTE=6
AAC_AI_ACCOUNT_BOARD_OUTSTANDING=2
AAC_AI_ACCOUNT_BOARD_CONCURRENCY=1
AAC_AI_ACCOUNT_JOB_STARTS_PER_MINUTE=30
AAC_AI_ACCOUNT_JOB_OUTSTANDING=2
AAC_AI_SERVICE_FOREGROUND_CONCURRENCY=2
AAC_AI_SERVICE_SPEECH_CONCURRENCY=1
AAC_AI_ACCOUNT_IMAGE_CONCURRENCY=9
AAC_AI_SERVICE_IMAGE_CONCURRENCY=12
# Server capability only: the selected picture source controls whether parents request generation.
AAC_IMAGE_GENERATION=true
# PICTURE_CACHE_DIR=C:/path/to/little-say-pictures
# Persistent generated audio; default resolves from apps/server in local dev.
# SPEECH_CACHE_DIR=C:/path/to/little-say-audio
# Local Expo development: npm run dev injects this computer's LAN URL.
# Leave DEV_HOST blank for automatic detection, or set your Wi-Fi/Ethernet IPv4.
DEV_HOST=
# Ports are selected automatically and remembered per worktree. Uncomment to pin exact ports.
# DEV_API_PORT=8788
# DEV_EXPO_PORT=8081
# npm run dev:remote starts only Expo and uses the deployed API (no local key required).
# Optional override for a different self-hosted HTTPS origin; ignored by local mode.
DEV_REMOTE_API_URL=https://littlesay.app
# Local dependencies are isolated from hosted credentials; these overrides also disable automatic selection.
# DEV_PG_PORT=15432
# DEV_AUTH_PORT=9099
# Explicit deterministic local AI, with no provider requests. Rejected by production.
AAC_AI_FIXTURES=false
# Set false to stop accepting new AI operations, even with a configured provider key.
AAC_AI_ENABLED=true
# HOST/PORT/ALLOWED_ORIGINS below are for standalone server / production use.
# The development launcher sets its own LAN listener and exact web origins.
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8787,http://127.0.0.1:8787
# Production: set ALLOWED_ORIGINS to your private HTTPS origin.
# Docker publishes only on this host interface; leave loopback when using a reverse proxy.
BIND_ADDRESS=127.0.0.1
