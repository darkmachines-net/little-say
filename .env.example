# The key stays on your server. Never use an EXPO_PUBLIC variable for a secret.
# AAC_OPENAI_KEY in your environment is preferred. On Windows, npm run dev
# also reads that User variable when the current terminal hasn't inherited it.
# Leave this blank when using AAC_OPENAI_KEY; no key is copied into this file.
OPENAI_API_KEY=
OPENAI_BOARD_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
OPENAI_SPEECH_VOICE=marin
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Optional browser ChatGPT plan usage. Hosted apps need OpenAI approval for both sign-in
# and plan usage; an identity-only client is insufficient. See docs/CHATGPT.md.
CHATGPT_ENABLED=false
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
CHATGPT_REDIRECT_URI=
# Independent 32-byte encryption key, encoded as 64 hex characters; keep it in server secrets.
CHATGPT_ENCRYPTION_KEY=
# CHATGPT_DB_PATH=C:/path/to/private/chatgpt-sessions.sqlite
# Server capability only: parents must also allow AI pictures before paid image generation.
AAC_IMAGE_GENERATION=true
# PICTURE_CACHE_DIR=C:/path/to/little-say-pictures
# Persistent generated audio; default resolves from apps/server in local dev.
# SPEECH_CACHE_DIR=C:/path/to/little-say-audio
# Local Expo Go development: npm run dev injects this computer's LAN URL.
# Leave DEV_HOST blank for automatic detection, or set your Wi-Fi/Ethernet IPv4.
DEV_HOST=
DEV_API_PORT=8788
DEV_EXPO_PORT=8081
# npm run dev:remote starts only Expo and uses the deployed API (no local key required).
# Optional override for a different self-hosted HTTPS origin; ignored by local mode.
DEV_REMOTE_API_URL=https://littlesay.darkmachines.net
# HOST/PORT/ALLOWED_ORIGINS below are for standalone server / production use.
# The development launcher sets its own LAN listener and exact web origins.
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8787,http://127.0.0.1:8787
# Production: set ALLOWED_ORIGINS to your private HTTPS origin.
# Docker publishes only on this host interface; leave loopback when using a reverse proxy.
BIND_ADDRESS=127.0.0.1
