{
  "cli": {
    "version": "25.3.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "internal": {
      "channel": "internal",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "LITTLE_SAY_CHANNEL": "internal"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "env": {
        "LITTLE_SAY_CHANNEL": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "6826487372"
      }
    },
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6826487372"
      }
    }
  }
}
