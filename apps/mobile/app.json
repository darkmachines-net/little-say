{
  "expo": {
    "name": "Little Say",
    "slug": "little-say",
    "version": "2.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "scheme": "littlesay",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.darkmachines.littlesay"
    },
    "android": {
      "package": "net.darkmachines.littlesay",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "name": "Little Say",
      "shortName": "Little Say"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to illustrate a soundboard tile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
